<Window x:Class="Ergonomy.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ergonomy" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="همیار سلامت" Icon="pack://application:,,,/Assets/AppIcon.png" Width="320" Height="76" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="False" Background="Transparent" WindowStartupLocation="Manual"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True"
 FontFamily="pack://application:,,,/Assets/Fonts/#IRANYekanX" Foreground="#F2F8FF" FlowDirection="RightToLeft">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="22" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF7FF"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="#26344B"/><Setter Property="BorderBrush" Value="#3D7996AA"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".35"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4C58778A"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#9DF6DD"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2,0" CornerRadius="3" Background="#6684A8B6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#25374D"/><Setter Property="Foreground" Value="#F2F8FF"/>
   <Setter Property="CaretBrush" Value="#83E8D0"/><Setter Property="BorderBrush" Value="#55768F"/>
   <Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style x:Key="FilterChip" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#D4E8EF"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chip" Background="#202F45" BorderBrush="#3F5A70" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="#386F63"/><Setter TargetName="Chip" Property="BorderBrush" Value="#83E8D0"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#83E8D0"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chip" Property="BorderThickness" Value="2"/><Setter TargetName="Chip" Property="BorderBrush" Value="#BDA9FF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Glass" CornerRadius="22" BorderThickness="1" BorderBrush="#405C7E98" Padding="16,10" Background="#A6172238">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
    <Image Grid.Column="0" Source="pack://application:,,,/Assets/AppIcon.png" Width="34" Height="34" AutomationProperties.Name="نشان همیار سلامت"/>
    <local:BuddyControl x:Name="DockBuddy" Visibility="Collapsed"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,5,0">
     <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" Text="همیار سلامت" FontSize="14" FontWeight="Bold"/>
     <TextBlock x:Name="NextText" TextTrimming="CharacterEllipsis" Text="مراقبت آرام از تو" Foreground="#BBD5E2" FontSize="11" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="PlusButton" Content="+" Padding="0" Width="28" Height="28" Background="Transparent" Click="Plus_Click" ToolTip="گزینه‌های سریع" AutomationProperties.Name="باز کردن سه گزینه سریع" Margin="0,0,4,0"/>
    <Button Content="−" Padding="0" Width="28" Height="28" VerticalAlignment="Center" Background="Transparent" Click="Hide_Click" ToolTip="مخفی‌کردن" AutomationProperties.Name="مخفی کردن در لبه راست"/>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
   <UniformGrid x:Name="QuickActions" Columns="3" Visibility="Collapsed" Margin="0,7,0,6">
    <Button Content="حرکت‌ها" Click="Library_Click" FontSize="12" Padding="4,9" Margin="0,0,3,0"/>
    <Button Content="زمان‌بندی" Click="Preferences_Click" FontSize="12" Padding="4,9" Margin="3,0"/>
    <Button Content="درباره" Click="About_Click" FontSize="11" Padding="4,9" Margin="3,0,0,0"/>
   </UniformGrid>
   <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Margin="0,10,0,10">
    <TextBlock Text="همیار سلامت" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock Text="طراحی و توسعه" Foreground="#BBD5E2" HorizontalAlignment="Center" FontSize="11" Margin="0,8,0,4"/>
    <TextBlock x:Name="AuthorName" Text="میرجعفری" FlowDirection="LeftToRight" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
    <TextBlock x:Name="AuthorPhone" Text="۰۹۱۸۶۴۴۱۸۰۱" FlowDirection="LeftToRight" FontSize="16" Foreground="#83E8D0" HorizontalAlignment="Center" Margin="0,8,0,10"/>
    <TextBlock Text="نسخهٔ ۰٫۷ · همراه آرام روز کاری" Foreground="#BBD5E2" FontSize="10" HorizontalAlignment="Center"/>
    <Expander Header="دربارهٔ راهنمای حرکت‌ها" Foreground="#BDD6E1" FontSize="11" Margin="0,12,0,0" Expanded="Details_Changed" Collapsed="Details_Changed">
     <TextBlock Text="حرکت‌ها از راهنماهای CCOHS، Mayo Clinic و NHS اقتباس شده‌اند. زمان‌ها پیش‌فرض قابل تنظیم‌اند، نه الزام قانونی یا نسخهٔ درمانی. حرکت را در محدودهٔ راحت انجام بده؛ اگر درد یا ناراحتی ایجاد شد، متوقفش کن." TextWrapping="Wrap" Margin="0,9,0,0"/>
    </Expander>
   </StackPanel>
   <StackPanel x:Name="LessonPanel" Visibility="Collapsed">
    <Border CornerRadius="18" BorderBrush="#335E8C9B" BorderThickness="1" Margin="0,4,0,12" Padding="0,5">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2B638A98"/><GradientStop Offset="1" Color="#163B345C"/></LinearGradientBrush></Border.Background>
     <local:BuddyControl x:Name="CoachBuddy" Width="274" Height="157"/>
    </Border>
    <TextBlock x:Name="StepTitle" TextWrapping="Wrap" Text="یک مکث کوتاه" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center"/>
    <TextBlock x:Name="StepHint" Text="" Foreground="#C0D7E2" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="StepNumber" Foreground="#96B9CB" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressBar x:Name="LessonProgress" Height="3" Maximum="100" Foreground="#75E5CE" Background="#30485A" BorderThickness="0" VerticalAlignment="Center"/>
     <Button x:Name="TimerButton" Grid.Column="1" Click="Timer_Click" Background="Transparent" Padding="7,3" Margin="7,0,0,0" ToolTip="مکث، ادامه یا تکرار همین حرکت" AutomationProperties.Name="مکث یا ادامه تایمر حرکت">
      <TextBlock x:Name="Countdown" Text="" Foreground="#91E7D6" FontSize="11"/>
     </Button>
    </Grid>
    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="PreviousButton" Content="حرکت قبلی" Click="Previous_Click" FontSize="11" Padding="7,7" Background="Transparent"/>
     <Button x:Name="NextButton" Grid.Column="1" Content="حرکت بعدی" Click="Next_Click" FontSize="11" Padding="7,7" Background="#344B626D" Margin="8,0,0,0"/>
    </Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="DoneButton" Grid.Column="0" Content="انجام شد ✓" Click="Done_Click" Background="#386F63" Margin="0,0,0,0"/>
     <Button Grid.Column="1" Content="بعداً" Click="Snooze_Click" Margin="8,0,0,0"/>
    </Grid>
   </StackPanel>
   <StackPanel x:Name="PreferencesPanel" Visibility="Collapsed" Margin="0,8,0,8">
    <StackPanel Margin="0,0,4,0">
     <TextBlock Text="زمان‌بندی یادآورها" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
     <TextBlock Text="فاصله‌ها بر حسب دقیقهٔ فعالیت" Foreground="#BBD5E2" FontSize="10" Margin="0,0,0,9"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CheckBox x:Name="EyeToggle" Content="استراحت چشم"/><TextBox x:Name="EyeMinutesInput" Grid.Column="1" Margin="0,3" AutomationProperties.Name="فاصله استراحت چشم به دقیقه"/>
      <CheckBox x:Name="PostureToggle" Grid.Row="1" Content="نشستن و گردن"/><TextBox x:Name="PostureMinutesInput" Grid.Row="1" Grid.Column="1" Margin="0,3" AutomationProperties.Name="فاصله بررسی نشستن به دقیقه"/>
      <CheckBox x:Name="MoveToggle" Grid.Row="2" Content="وقفه و حرکت"/><TextBox x:Name="MoveMinutesInput" Grid.Row="2" Grid.Column="1" Margin="0,3" AutomationProperties.Name="فاصله حرکت به دقیقه"/>
      <CheckBox x:Name="WaterToggle" Grid.Row="3" Content="نوشیدن آب"/><TextBox x:Name="WaterMinutesInput" Grid.Row="3" Grid.Column="1" Margin="0,3" AutomationProperties.Name="فاصله یادآور آب به دقیقه"/>
     </Grid>
     <CheckBox x:Name="StartupToggle" Content="شروع با ویندوز"/>
     <CheckBox x:Name="MotionToggle" Content="نمایش حرکت‌ها"/>
     <TextBlock Text="یادآورهای شخصی" FontSize="14" FontWeight="Bold" Margin="0,12,0,8"/>
     <ItemsControl x:Name="PersonalRemindersList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#23374B" CornerRadius="12" Padding="9" Margin="0,0,0,8"><StackPanel>
       <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="عنوان یادآور شخصی"/>
       <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" Margin="0,6,0,0" AutomationProperties.Name="متن یادآور شخصی"/>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox Content="فعال" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Text="{Binding IntervalText, Mode=TwoWay, ValidatesOnExceptions=True}" AutomationProperties.Name="فاصله یادآور شخصی به دقیقه"/>
        <Button Grid.Column="2" Content="حذف" Tag="{Binding Id}" Click="RemovePersonal_Click" Padding="8,5" Margin="6,0,0,0"/>
       </Grid>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="+ یادآور جدید" Click="NewPersonal_Click" Background="Transparent"/>
     <StackPanel x:Name="NewPersonalPanel" Visibility="Collapsed" Margin="0,9,0,0">
      <TextBlock Text="عنوان" FontSize="11"/><TextBox x:Name="PersonalTitleInput" MaxLength="60" Margin="0,4,0,6"/>
      <TextBlock Text="متن کوتاه" FontSize="11"/><TextBox x:Name="PersonalMessageInput" MaxLength="160" Margin="0,4,0,6"/>
      <TextBlock Text="هر چند دقیقه؟" FontSize="11"/><TextBox x:Name="PersonalMinutesInput" Text="۶۰" Margin="0,4,0,7"/>
      <Button Content="افزودن به فهرست" Click="AddPersonal_Click"/>
     </StackPanel>
     <TextBlock x:Name="SettingsStatus" Foreground="#A4EBD9" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
     <Button Content="ذخیرهٔ تنظیمات" Click="Save_Click" Margin="0,12,0,0" Background="#386F63"/>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="LibraryPanel" Visibility="Collapsed" Margin="0,9,0,8">
    <TextBlock Text="حرکت‌های آرام اداری" FontSize="17" FontWeight="Bold"/>
    <TextBlock Text="یک حرکت انتخاب کن؛ آرام و راحت" FontSize="10" Foreground="#BDD6E1" Margin="0,6,0,9"/>
    <ListBox x:Name="ExerciseFilter" SelectionChanged="ExerciseFilter_Changed" ItemContainerStyle="{StaticResource FilterChip}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,7" AutomationProperties.Name="دکمه‌های گروه حرکت‌ها">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBoxItem Content="همه"/><ListBoxItem Content="چشم"/><ListBoxItem Content="گردن و شانه"/><ListBoxItem Content="بالاتنه"/><ListBoxItem Content="دست و مچ"/><ListBoxItem Content="نشستن"/><ListBoxItem Content="حرکت و پا"/>
    </ListBox>
    <Expander x:Name="WorkstationDetails" Header="چک سریع میز کار" Foreground="#BDE9DE" FontSize="12" Margin="0,0,0,10" Expanded="Details_Changed" Collapsed="Details_Changed">
     <StackPanel Margin="0,9,0,0">
      <TextBlock Text="خودت بررسی کن؛ هر مورد آماده است تیک بزن" TextWrapping="Wrap" FontSize="10" Foreground="#BDD6E1"/>
      <CheckBox x:Name="CheckMonitor" Content="مانیتور روبه‌رو؛ بالای آن هم‌سطح چشم یا پایین‌تر" FontSize="10" Checked="Workstation_Changed" Unchecked="Workstation_Changed"/>
      <CheckBox x:Name="CheckBack" Content="کمر تکیه‌گاه دارد؛ شانه‌ها راحت‌اند" FontSize="10" Checked="Workstation_Changed" Unchecked="Workstation_Changed"/>
      <CheckBox x:Name="CheckFeet" Content="کف پا روی زمین یا زیرپایی است" FontSize="10" Checked="Workstation_Changed" Unchecked="Workstation_Changed"/>
      <CheckBox x:Name="CheckWrists" Content="مچ‌ها هم‌راستای ساعد؛ موس نزدیک است" FontSize="10" Checked="Workstation_Changed" Unchecked="Workstation_Changed"/>
      <CheckBox x:Name="CheckLight" Content="نور و بازتاب صفحه چشم را اذیت نمی‌کند" FontSize="10" Checked="Workstation_Changed" Unchecked="Workstation_Changed"/>
      <TextBlock x:Name="WorkstationStatus" Text="۰ از ۵ مورد بررسی شد" FontSize="11" Foreground="#83E8D0" Margin="0,3,0,7"/>
      <TextBlock Text="برگرفته از چک‌لیست OSHA · خودارزیابی" FontSize="9" Foreground="#BDD6E1"/>
     </StackPanel>
    </Expander>
    <ItemsControl x:Name="ExercisesList">
     <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding Motion}" Click="Exercise_Click" Margin="0,0,0,6" Padding="10,10" FontSize="12" HorizontalContentAlignment="Right"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <StackPanel x:Name="PersonalPanel" Visibility="Collapsed" Margin="0,14,0,4">
    <TextBlock x:Name="PersonalMessageText" TextWrapping="Wrap" Foreground="#DDECF5" FontSize="15" Margin="0,6,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Content="انجام شد ✓" Click="Done_Click" Background="#386F63"/>
     <Button Grid.Column="1" Content="بعداً" Click="Snooze_Click" Margin="8,0,0,0"/>
    </Grid>
   </StackPanel>
   </Grid></ScrollViewer>
  </Grid>
 </Border>
</Window>

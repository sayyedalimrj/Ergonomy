<Window x:Class="Ergonomy.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Ergonomy · Workplace Wellness" Width="680" Height="720"
  MinWidth="590" MinHeight="600"
  WindowStartupLocation="CenterScreen" Background="#0D1424">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F6FC"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F4F6FC"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,6,0,6"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Width" Value="75"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#19243A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#3A506B"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,28,30,28" FlowDirection="RightToLeft">
      <TextBlock Text="ERGONOMY" FontSize="16" Foreground="#7CEAD6" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
      <TextBlock Text="مراقب سلامتت، وسط کار" FontSize="28" FontWeight="Bold" Margin="0,8,0,5"/>
      <TextBlock Text="یادآوری‌های هوشمند برای چشم، نشستن و حرکت — بدون دوربین یا ردیابی صفحه."
                 Foreground="#B9C6DB" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,21"/>
      <Border Background="#15243A" BorderBrush="#26445C" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,17">
        <StackPanel>
          <TextBlock Text="برنامهٔ یادآوری" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="EyeEnabled" Content="استراحت چشم (۲۰-۲۰-۲۰)" IsChecked="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="EyeMinutes" Text="20" FlowDirection="LeftToRight"/>
              <TextBlock Text=" دقیقه" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="PostureEnabled" Content="بازبینی وضعیت بدن" IsChecked="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="PostureMinutes" Text="30" FlowDirection="LeftToRight"/>
              <TextBlock Text=" دقیقه" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="MoveEnabled" Content="وقفهٔ حرکتی و دوری از نمایشگر" IsChecked="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="MoveMinutes" Text="55" FlowDirection="LeftToRight"/>
              <TextBlock Text=" دقیقه" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="WaterEnabled" Content="یادآوری اختیاری نوشیدن آب" IsChecked="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="WaterMinutes" Text="120" FlowDirection="LeftToRight"/>
              <TextBlock Text=" دقیقه" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Background="#15243A" CornerRadius="18" Padding="18">
        <StackPanel>
          <TextBlock Text="رفتار نرم‌افزار" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <CheckBox x:Name="AutoStart" Content="اجرای خودکار پس از ورود به ویندوز"/>
          <TextBlock Text="در حالت بی‌کاری بیش از ۳ دقیقه، شمارندهٔ کار متوقف می‌شود. اعلان‌ها قابل رد کردن یا تعویق هستند."
                     TextWrapping="Wrap" Foreground="#AAB9CB" Margin="0,10,0,0" FontSize="13"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
        <Button x:Name="SaveButton" Content="ذخیره تنظیمات" Click="Save_Click" Background="#47D9BD"
                Foreground="#0C1825" FontWeight="Bold" FontSize="15" Padding="22,12" BorderThickness="0" Cursor="Hand"/>
        <Button Content="نمایش آزمایشی اعلان" Click="Preview_Click" Background="#253A56"
                Foreground="White" FontSize="14" Padding="16,12" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Text="یادآورها فعال‌اند. بستن پنجره، برنامه را در کنار ساعت ویندوز نگه می‌دارد."
                 FontSize="13" Foreground="#A5B8C8" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="نسخهٔ آزمایشی — ابزار اطلاع‌رسانی، نه سامانهٔ تشخیص وضعیت بدن یا دستگاه پزشکی."
                 FontSize="12" Foreground="#7E92AB" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>

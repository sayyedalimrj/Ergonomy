<Window x:Class="Ergonomy.ReminderWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="430" Height="220" WindowStyle="None" AllowsTransparency="True"
  Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
  ResizeMode="NoResize" Topmost="True" WindowStartupLocation="Manual">
  <Border Margin="12" Padding="21" CornerRadius="23" Background="#17273D"
          BorderBrush="#3D6780" BorderThickness="1" FlowDirection="RightToLeft">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="5" Color="#17273D" Opacity=".55"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Heading" Text="یک استراحت کوتاه" FontFamily="Segoe UI" Foreground="#8FF7DB"
                 FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock x:Name="Description" Grid.Row="1" TextWrapping="Wrap" Foreground="White"
                 FontSize="16" FontFamily="Segoe UI"/>
      <TextBlock Grid.Row="2" Foreground="#9DB7CA" FontSize="11" FontFamily="Segoe UI"
                 Text="Ergonomy · مراقبت بدون مزاحمت" VerticalAlignment="Center"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="انجام شد" Click="Done_Click" Padding="17,8" Background="#50DFC0" Foreground="#14253B"
                BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        <Button Content="۱۰ دقیقه بعد" Click="Snooze_Click" Padding="13,8" Margin="9,0,0,0"
                Background="#314862" Foreground="White" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
